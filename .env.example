# PostgreSQL
POSTGRES_DB=architecture_registry
POSTGRES_USER=registry_admin
POSTGRES_PASSWORD=registry_pass
POSTGRES_PORT=5433

# Backend API
BACKEND_PORT=3001
CORS_ORIGIN=http://localhost:8080

# Frontend
FRONTEND_PORT=8080

# Модуль «Архитектурные схемы» (отдельный контейнер визуализации C4)
DIAGRAMS_PORT=8082
DIAGRAMS_CORS_ORIGIN=http://localhost:8082
DIAGRAMS_DEFAULT_ROLE=ARCHITECT
DIAGRAMS_USER=diagram-module
REGISTRY_PUBLIC_URL=http://localhost:8080
# Встраивание модуля в общее приложение (nginx реестра): префикс SPA модуля и база его API
DIAGRAMS_BASE_PATH=/diagrams-module
DIAGRAMS_API_BASE=/diagrams-api
# Публичный адрес модуля на отдельном порту — используется ссылкой «в отдельном окне»
DIAGRAMS_PUBLIC_URL=http://localhost:8082
